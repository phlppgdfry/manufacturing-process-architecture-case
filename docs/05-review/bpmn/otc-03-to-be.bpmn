<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_otc_03_to_be" targetNamespace="https://github.com/phlppgdfry/manufacturing-process-architecture-case" exporter="build_models.py" exporterVersion="1">
  <bpmn:collaboration id="Collab_otc_03_to_be">
    <bpmn:participant id="Pool_otc_03_to_be" name="OTC-03 Leverdatum bevestigen — to-be v1.0 (na review)" processRef="Process_otc_03_to_be" />
  </bpmn:collaboration>
  <bpmn:process id="Process_otc_03_to_be" name="OTC-03 Leverdatum bevestigen — to-be v1.0 (na review)" isExecutable="false">
    <bpmn:documentation>procesId: OTC-03
niveau: L3
type: to-be
eigenaar: open (voorstel D-03: Supply chain director)
versie: 1.0
status: in-review
volgt op: OTC-02 Order aanvaarden
volgt: OTC-04 Order uitleveren</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_otc_03_to_be">
      <bpmn:lane id="Lane_cs" name="Customer service">
        <bpmn:flowNodeRef>t_cancel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_cancel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_ok</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_am" name="Accountmanager">
        <bpmn:flowNodeRef>t_negotiate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_acc</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_planner" name="Planner">
        <bpmn:flowNodeRef>t_assess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_feas</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_erp" name="ERP">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_atp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_std</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_register</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Order aanvaard (uit OTC-02)">
      <bpmn:outgoing>Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="t_atp" name="Haalbare leverdatum voorstellen">
      <bpmn:incoming>Flow_0</bpmn:incoming>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g_std" name="Binnen standaard levertermijn?">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="t_assess" name="Haalbaarheid met productie afstemmen">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g_feas" name="Gevraagde datum haalbaar?">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="t_negotiate" name="Alternatieve datum met klant afstemmen">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g_acc" name="Klant akkoord?">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="t_cancel" name="Order in overleg annuleren">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="end_cancel" name="Order geannuleerd">
      <bpmn:incoming>Flow_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="t_register" name="Bevestigde leverdatum vastleggen">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="t_send" name="Orderbevestiging met leverdatum versturen">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="end_ok" name="Leverdatum bevestigd (naar OTC-04)">
      <bpmn:incoming>Flow_12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0" sourceRef="start" targetRef="t_atp" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="t_atp" targetRef="g_std" />
    <bpmn:sequenceFlow id="Flow_2" name="ja" sourceRef="g_std" targetRef="t_register" />
    <bpmn:sequenceFlow id="Flow_3" name="nee" sourceRef="g_std" targetRef="t_assess" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="t_assess" targetRef="g_feas" />
    <bpmn:sequenceFlow id="Flow_5" name="ja" sourceRef="g_feas" targetRef="t_register" />
    <bpmn:sequenceFlow id="Flow_6" name="nee" sourceRef="g_feas" targetRef="t_negotiate" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="t_negotiate" targetRef="g_acc" />
    <bpmn:sequenceFlow id="Flow_8" name="ja" sourceRef="g_acc" targetRef="t_register" />
    <bpmn:sequenceFlow id="Flow_9" name="nee" sourceRef="g_acc" targetRef="t_cancel" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="t_cancel" targetRef="end_cancel" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="t_register" targetRef="t_send" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="t_send" targetRef="end_ok" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_otc_03_to_be">
    <bpmndi:BPMNPlane id="Plane_otc_03_to_be" bpmnElement="Collab_otc_03_to_be">
      <bpmndi:BPMNShape id="Pool_otc_03_to_be_di" bpmnElement="Pool_otc_03_to_be" isHorizontal="true">
