<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_otc_03_draft" targetNamespace="https://github.com/phlppgdfry/manufacturing-process-architecture-case" exporter="build_models.py" exporterVersion="1">
  <bpmn:collaboration id="Collab_otc_03_draft">
    <bpmn:participant id="Pool_otc_03_draft" name="Leverdatum (draft analist)" processRef="Process_otc_03_draft" />
  </bpmn:collaboration>
  <bpmn:process id="Process_otc_03_draft" name="Leverdatum (draft analist)" isExecutable="false">
    <bpmn:laneSet id="LaneSet_otc_03_draft">
      <bpmn:lane id="Lane_planner" name="Jan (planning)">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_sales" name="Sales">
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_erp" name="ERP">
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Order in ERP">
      <bpmn:outgoing>Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="t1" name="Capaciteitscheck">
      <bpmn:incoming>Flow_0</bpmn:incoming>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:inclusiveGateway id="g1" name="Check">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:userTask id="t3" name="Datum aanpassen">
      <bpmn:incoming>Flow_2</bpmn:incoming>
    </bpmn:userTask>
    <bpmn:serviceTask id="t4" name="Leverdatum in ERP registreren">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="t2" name="Mail naar klant">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="end" name="Klant ingelicht">
      <bpmn:incoming>Flow_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0" sourceRef="start" targetRef="t1" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="t1" targetRef="g1" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="g1" targetRef="t3" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="g1" targetRef="t4" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="t4" targetRef="t2" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="t2" targetRef="end" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_otc_03_draft">
    <bpmndi:BPMNPlane id="Plane_otc_03_draft" bpmnElement="Collab_otc_03_draft">
      <bpmndi:BPMNShape id="Pool_otc_03_draft_di" bpmnElement="Pool_otc_03_draft" isHorizontal="true">
        <dc:Bounds x="0" y="0" width="1042" height="390" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_planner_di" bpmnElement="Lane_planner" isHorizontal="true">
        <dc:Bounds x="34" y="0" width="1008" height="130" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_sales_di" bpmnElement="Lane_sales" isHorizontal="true">
        <dc:Bounds x="34" y="130" width="1008" height="130" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_erp_di" bpmnElement="Lane_erp" isHorizontal="true">
        <dc:Bounds x="34" y="260" width="1008" height="130" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_di" bpmnElement="start">
        <dc:Bounds x="105" y="47" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t1_di" bpmnElement="t1">
        <dc:Bounds x="222" y="32" width="118" height="66" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="g1_di" bpmnElement="g1">
        <dc:Bounds x="414" y="40" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t3_di" bpmnElement="t3">
        <dc:Bounds x="538" y="32" width="118" height="66" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t4_di" bpmnElement="t4">
        <dc:Bounds x="538" y="292" width="118" height="66" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t2_di" bpmnElement="t2">
        <dc:Bounds x="696" y="162" width="118" height="66" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_di" bpmnElement="end">
        <dc:Bounds x="895" y="177" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_0_di" bpmnElement="Flow_0">
        <di:waypoint x="141" y="65" />
        <di:waypoint x="222" y="65" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="340" y="65" />
        <di:waypoint x="414" y="65" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="464" y="65" />
        <di:waypoint x="538" y="65" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="464" y="65" />
        <di:waypoint x="518" y="65" />
        <di:waypoint x="518" y="325" />
        <di:waypoint x="538" y="325" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="656" y="325" />
        <di:waypoint x="676" y="325" />
        <di:waypoint x="676" y="195" />
        <di:waypoint x="696" y="195" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <di:waypoint x="814" y="195" />
        <di:waypoint x="895" y="195" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
