<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_ste_04_proceswijziging" targetNamespace="https://github.com/phlppgdfry/manufacturing-process-architecture-case" exporter="build_models.py" exporterVersion="1">
  <bpmn:collaboration id="Collab_ste_04_proceswijziging">
    <bpmn:participant id="Pool_ste_04_proceswijziging" name="STE-04 Proceswijziging doorvoeren — v1.0" processRef="Process_ste_04_proceswijziging" />
  </bpmn:collaboration>
  <bpmn:process id="Process_ste_04_proceswijziging" name="STE-04 Proceswijziging doorvoeren — v1.0" isExecutable="false">
    <bpmn:documentation>procesId: STE-04
niveau: L3
type: to-be
eigenaar: COO
versie: 1.0
status: released
besluit: procesraad #1, D-01</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_ste_04_proceswijziging">
      <bpmn:lane id="Lane_steward" name="Process steward">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_request</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_analyst" name="Business process analyst">
        <bpmn:flowNodeRef>t_model</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_architect" name="Process architect">
        <bpmn:flowNodeRef>t_review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_level</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_owner" name="Proceseigenaar">
        <bpmn:flowNodeRef>t_approve</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_raad" name="Procesraad">
        <bpmn:flowNodeRef>t_raad</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_rej</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_cat" name="Procescatalogus">
        <bpmn:flowNodeRef>t_check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_pass</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_release</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_ok</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Wijziging nodig (project, audit of verbetering)">
      <bpmn:outgoing>Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="t_request" name="Wijzigingsverzoek registreren">
      <bpmn:incoming>Flow_0</bpmn:incoming>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="t_model" name="Model volgens conventie aanpassen">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="t_check" name="Model automatisch toetsen">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g_pass" name="Alle checks geslaagd?">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="t_review" name="Model reviewen">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g_level" name="Raakt L1 of een overdracht?">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="t_approve" name="Wijziging goedkeuren">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="t_raad" name="Wijziging in procesraad beslissen">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g_ok" name="Goedgekeurd?">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="end_rej" name="Wijziging afgewezen">
      <bpmn:incoming>Flow_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="t_release" name="Nieuwe versie publiceren">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end_ok" name="Versie released, vorige versie retired">
      <bpmn:incoming>Flow_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0" sourceRef="start" targetRef="t_request" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="t_request" targetRef="t_model" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="t_model" targetRef="t_check" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="t_check" targetRef="g_pass" />
    <bpmn:sequenceFlow id="Flow_4" name="ja" sourceRef="g_pass" targetRef="t_review" />
    <bpmn:sequenceFlow id="Flow_5" name="nee" sourceRef="g_pass" targetRef="t_model" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="t_review" targetRef="g_level" />
    <bpmn:sequenceFlow id="Flow_7" name="ja" sourceRef="g_level" targetRef="t_raad" />
    <bpmn:sequenceFlow id="Flow_8" name="nee" sourceRef="g_level" targetRef="t_approve" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="t_raad" targetRef="g_ok" />
    <bpmn:sequenceFlow id="Flow_10" name="nee" sourceRef="g_ok" targetRef="end_rej" />
    <bpmn:sequenceFlow id="Flow_11" name="ja" sourceRef="g_ok" targetRef="t_release" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="t_approve" targetRef="t_release" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="t_release" targetRef="end_ok" />
  </bpmn:process>
