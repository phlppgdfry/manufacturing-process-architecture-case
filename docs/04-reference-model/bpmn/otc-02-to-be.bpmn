<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_otc_02_to_be" targetNamespace="https://github.com/phlppgdfry/manufacturing-process-architecture-case" exporter="build_models.py" exporterVersion="1">
  <bpmn:collaboration id="Collab_otc_02_to_be">
    <bpmn:participant id="Pool_otc_02_to_be" name="OTC-02 Order aanvaarden — to-be v1.0" processRef="Process_otc_02_to_be" />
  </bpmn:collaboration>
  <bpmn:process id="Process_otc_02_to_be" name="OTC-02 Order aanvaarden — to-be v1.0" isExecutable="false">
    <bpmn:documentation>procesId: OTC-02
niveau: L3
type: to-be
eigenaar: Customer service manager
versie: 1.0
status: in-review
volgt: OTC-03 Leverdatum bevestigen</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_otc_02_to_be">
      <bpmn:lane id="Lane_cs" name="Customer service">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_register</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_cfg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_inform</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_inf</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_am" name="Accountmanager">
        <bpmn:flowNodeRef>t_configure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_renegotiate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_rej</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_credit" name="Credit controller">
        <bpmn:flowNodeRef>t_review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>b_4h</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_approved</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_erp" name="ERP">
        <bpmn:flowNodeRef>t_credit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_limit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_accept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_ok</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Order ontvangen (portaal, EDI, mail)">
      <bpmn:outgoing>Flow_0</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Msg_start" />
    </bpmn:startEvent>
    <bpmn:userTask id="t_register" name="Order registreren en volledigheid controleren">
      <bpmn:incoming>Flow_0</bpmn:incoming>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g_cfg" name="Klantspecifieke uitvoering?">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="t_configure" name="Configuratie in productconfigurator vastleggen">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="t_credit" name="Kredietlimiet automatisch controleren">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g_limit" name="Binnen kredietlimiet?">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="t_review" name="Kredietuitzondering beoordelen">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="b_4h" name="4 werkuren zonder beslissing" attachedToRef="t_review" cancelActivity="false">
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_b_4h" />
    </bpmn:boundaryEvent>
    <bpmn:sendTask id="t_inform" name="Klant over wachttijd informeren">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="end_inf" name="Klant geïnformeerd">
      <bpmn:incoming>Flow_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="g_approved" name="Krediet goedgekeurd?">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="t_renegotiate" name="Betaalvoorwaarden met klant heronderhandelen">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="end_rej" name="Order niet aanvaard">
      <bpmn:incoming>Flow_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="t_accept" name="Order aanvaarden en vrijgeven">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end_ok" name="Order aanvaard (naar OTC-03)">
      <bpmn:incoming>Flow_14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0" sourceRef="start" targetRef="t_register" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="t_register" targetRef="g_cfg" />
    <bpmn:sequenceFlow id="Flow_2" name="ja" sourceRef="g_cfg" targetRef="t_configure" />
    <bpmn:sequenceFlow id="Flow_3" name="nee" sourceRef="g_cfg" targetRef="t_credit" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="t_configure" targetRef="t_credit" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="t_credit" targetRef="g_limit" />
    <bpmn:sequenceFlow id="Flow_6" name="ja" sourceRef="g_limit" targetRef="t_accept" />
    <bpmn:sequenceFlow id="Flow_7" name="nee" sourceRef="g_limit" targetRef="t_review" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="t_review" targetRef="g_approved" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="b_4h" targetRef="t_inform" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="t_inform" targetRef="end_inf" />
    <bpmn:sequenceFlow id="Flow_11" name="ja" sourceRef="g_approved" targetRef="t_accept" />
    <bpmn:sequenceFlow id="Flow_12" name="nee" sourceRef="g_approved" targetRef="t_renegotiate" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="t_renegotiate" targetRef="end_rej" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="t_accept" targetRef="end_ok" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_otc_02_to_be">
    <bpmndi:BPMNPlane id="Plane_otc_02_to_be" bpmnElement="Collab_otc_02_to_be">
